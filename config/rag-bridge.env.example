# Bridge glimmerlocal ↔ RAG (plataforma). Copiar para rag-bridge.env (gitignored).
# Secrets: NÃO duplicar passwords aqui — source do rag.env da plataforma.

# SoT Postgres RAG (não duplicar stack)
RAG_ROOT=/run/media/petterlopes/SSD930/devsec/peritumct/peritumct-sec-platform/rag
RAG_ENV_FILE=${RAG_ROOT}/secrets/rag.env

# Retrieve (role rag_query — nunca role rag no chat)
RAG_PG_HOST=127.0.0.1
RAG_PG_PORT=5433
RAG_PG_USER=rag_query
PGSSLMODE=disable
RAG_EMBED_BACKEND=fastembed
FASTEMBED_CACHE_PATH=${HOME}/.cache/peritumct/fastembed

# Muse OpenAI-compatible (preenchido a partir de muse-glimmer.env se omitido)
# MUSE_HOST=100.74.1.232
# MUSE_PORT=8080
MUSE_MODEL=muse-glimmer-30B
MUSE_MAX_TOKENS=1024
MUSE_REASONING_STRENGTH=low

# Segurança
# - Só literatura/protocolo no corpus; zero PII processual no RAG
# - LLM só Muse local (sem cloud)
