# Copy to muse-glimmer.env and adjust. Never commit muse-glimmer.env.
# Prefer starting from config/profiles/{baseline,fit-only,perf,perf-dflash}.env

# Root for tools/ + models/ (large data; keep outside Git)
IALOCAL_DATA=/run/media/petterlopes/SSD930

# Bind (localhost only by default — do not expose without auth)
MUSE_HOST=127.0.0.1
MUSE_PORT=8080

# Inference profile (validated hybrid offload on RTX 4060 8GB)
MUSE_REASONING=medium
MUSE_VISION=0
MUSE_CTX=32768
MUSE_FIT_TARGET=768
MUSE_FIT_CTX=8192
MUSE_THREADS=24
MUSE_LOAD_MODE=mmap

# Speculation: none | ngram-mod | draft-dflash | ...
MUSE_SPEC_TYPE=none
MUSE_DFLASH=0
MUSE_DRAFT_N_MAX=5
MUSE_REASONING_BUDGET=-1
MUSE_PRIO=0

# Optional: Hugging Face token for higher rate limits
# HF_TOKEN=

# Build parallelism for llama.cpp CUDA (keep modest to avoid nvcc/cicc crashes)
LLAMA_BUILD_JOBS=6
