# Profile: desktop-ondemand — chat sob pedido (menu Admin), margem VRAM para GNOME/Brave/Radar
IALOCAL_DATA=/run/media/petterlopes/SSD930
# Modelo B: bind overlay NetBird (Traefik → este IP). Sem LAN 0.0.0.0.
MUSE_HOST=100.74.1.232
MUSE_PORT=8080
MUSE_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,https://muse.peritumctsecops.expertsforensic.com
MODEL_GGUF=/run/media/petterlopes/SSD930/models/Muse-Glimmer-30B-Unsloth-GGUF/Muse-Glimmer-30B-UD-Q3_K_XL.gguf
MUSE_REASONING=low
MUSE_VISION=0
MUSE_CTX=8192
# ≥1536 MiB livres na RTX 4060 8GB — evita blocos pretos no desktop
MUSE_FIT_TARGET=1536
MUSE_FIT_CTX=4096
MUSE_THREADS=16
MUSE_LOAD_MODE=mmap
MUSE_SPEC_TYPE=ngram-mod
MUSE_DFLASH=0
MUSE_DRAFT_N_MAX=8
MUSE_REASONING_BUDGET=256
MUSE_PRIO=2
# UI Muse ↔ MCP RAG (loopback 8091) — ver config/muse-ui.json
MUSE_UI_MCP_PROXY=1
MUSE_RAG_MCP_AUTOSTART=1
