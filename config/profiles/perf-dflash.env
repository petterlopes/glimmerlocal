# Profile: perf-dflash — DFlash on CPU/RAM (8GB VRAM cannot hold main+draft)
IALOCAL_DATA=/run/media/petterlopes/SSD930
MUSE_HOST=127.0.0.1
MUSE_PORT=8080
MUSE_REASONING=low
MUSE_VISION=0
MUSE_CTX=8192
MUSE_FIT_TARGET=256
MUSE_FIT_CTX=4096
MUSE_THREADS=16
MUSE_LOAD_MODE=mmap
MUSE_SPEC_TYPE=draft-dflash
MUSE_DFLASH=1
MUSE_DRAFT_N_MAX=5
MUSE_DRAFT_NGL=0
MUSE_REASONING_BUDGET=256
MUSE_PRIO=2
