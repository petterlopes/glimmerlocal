[Unit]
Description=Muse Glimmer 30B (llama-server) — PeritumCT glimmerlocal (on-demand)
Documentation=file:///run/media/petterlopes/SSD930/devsec/peritumct/glimmerlocal/docs/RUNBOOK.md
Documentation=file:///run/media/petterlopes/SSD930/devsec/peritumct/glimmerlocal/docs/REVISAO_ONDEMAND_RAG_PERF.md
After=network-online.target
Wants=network-online.target
# Não enable no login: usar scripts/muse-adminctl.sh ou «Muse Glimmer Admin».

[Service]
Type=simple
WorkingDirectory=/run/media/petterlopes/SSD930/devsec/peritumct/glimmerlocal
EnvironmentFile=-/run/media/petterlopes/SSD930/devsec/peritumct/glimmerlocal/config/muse-glimmer.env
ExecStart=/run/media/petterlopes/SSD930/devsec/peritumct/glimmerlocal/scripts/start-server-fg.sh
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
LimitMEMLOCK=infinity
OOMScoreAdjust=-200

[Install]
# WantedBy presente para quem optar por --enable-boot; omissão recomendada = disable
WantedBy=default.target
